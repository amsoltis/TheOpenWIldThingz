    sub y' o' u' by w_you;
    ignore sub @letter b' u' t';
    ignore sub b' u' t' @letter;
    sub b' u' t' by w_but;
    ignore sub @letter h' i' s';
    ignore sub h' i' s' @letter;
    sub h' i' s' by w_his;
    ignore sub @letter s' a' y';
    ignore sub s' a' y' @letter;
    sub s' a' y' by w_say;
    ignore sub @letter h' e' r';
    ignore sub h' e' r' @letter;
    sub h' e' r' by w_her;
    ignore sub @letter s' h' e';
    ignore sub s' h' e' @letter;
    sub s' h' e' by w_she;
    ignore sub @letter o' n' e';
    ignore sub o' n' e' @letter;
    sub o' n' e' by w_one;
    ignore sub @letter a' l' l';
    ignore sub a' l' l' @letter;
    sub a' l' l' by w_all;
    ignore sub @letter b' e';
    ignore sub b' e' @letter;
    sub b' e' by w_be;
    ignore sub @letter t' o';
    ignore sub t' o' @letter;
    sub t' o' by w_to;
    ignore sub @letter o' f';
    ignore sub o' f' @letter;
    sub o' f' by w_of;
    ignore sub @letter i' n';
    ignore sub i' n' @letter;
    sub i' n' by w_in;
    ignore sub @letter i' t';
    ignore sub i' t' @letter;
    sub i' t' by w_it;
    ignore sub @letter o' n';
    ignore sub o' n' @letter;
    sub o' n' by w_on;
    ignore sub @letter h' e';
    ignore sub h' e' @letter;
    sub h' e' by w_he;
    ignore sub @letter a' s';
    ignore sub a' s' @letter;
    sub a' s' by w_as;
    ignore sub @letter d' o';
    ignore sub d' o' @letter;
    sub d' o' by w_do;
    ignore sub @letter a' t';
    ignore sub a' t' @letter;
    sub a' t' by w_at;
    ignore sub @letter b' y';
    ignore sub b' y' @letter;
    sub b' y' by w_by;
    ignore sub @letter w' e';
    ignore sub w' e' @letter;
    sub w' e' by w_we;
    ignore sub @letter o' r';
    ignore sub o' r' @letter;
    sub o' r' by w_or;
    ignore sub @letter a';
    ignore sub a' @letter;
    sub a' by w_a;
} phonoglyph_collapse;

lookup phonoglyph_expand {
    sub w_pronunciation by p r u h hyphen n u n hyphen s e e hyphen a y hyphen s h u n;
    sub w_typography by t y hyphen p o g hyphen r u h hyphen f e e;
    sub w_wednesday by w e n z hyphen d a y;
    sub w_laughter by l a f hyphen t u r;
    sub w_february by f e b hyphen r o o hyphen a i r hyphen e e;
    sub w_question by k w e s hyphen c h u n;
    sub w_because by b e e hyphen c u z;
    sub w_through by t h r o o;
    sub w_thought by t h a w t;
    sub w_colonel by k u r hyphen n u l;
    sub w_receipt by r e e hyphen s e e t;
    sub w_people by p e e hyphen p u l;
    sub w_though by t h o h;
    sub w_enough by e e hyphen n u f;
    sub w_island by e y e hyphen l u n d;
    sub w_nation by n a y hyphen s h u n;
    sub w_subtle by s u t hyphen u l;
    sub w_would by w o o d;
    sub w_there by t h a i r;
    sub w_their by t h a i r;
    sub w_water by w a w hyphen t u r;
    sub w_cough by k o f;
    sub w_yacht by y o t;
    sub w_choir by k w y r;
    sub w_knife by n y f;
    sub w_gnome by n o h m;
    sub w_sword by s o r d;
    sub w_that by t h a t;
    sub w_have by h a v;
    sub w_with by w i t h;
    sub w_this by t h i s;
    sub w_from by f r o m;
    sub w_they by t h a y;
    sub w_will by w i l;
    sub w_what by w h u t;
    sub w_the by t h u h;
    sub w_and by a n d;
    sub w_for by f o r;
    sub w_not by n o t;
    sub w_you by y o o;
    sub w_but by b u t;
    sub w_his by h i z;
    sub w_say by s a y;
    sub w_her by h u r;
    sub w_she by s h e e;
    sub w_one by w u n;
    sub w_all by a w l;
    sub w_be by b e e;
    sub w_to by t o o;
    sub w_of by u v;
    sub w_in by i n;
    sub w_it by i t;
    sub w_on by o n;
    sub w_he by h e e;
    sub w_as by a z;
    sub w_do by d o o;
    sub w_at by a t;
    sub w_by by b y;
    sub w_we by w e e;
    sub w_or by o r;
    sub w_a by u h;
} phonoglyph_expand;

feature calt {
    lookup phonoglyph_collapse;
    lookup phonoglyph_expand;
} calt;
