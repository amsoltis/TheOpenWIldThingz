# Phonoglyph — generated by build_font.py (boundary-guarded G2P in GSUB)
@letter = [a b c d e f g h i j k l m n o p q r s t u v w x y z];

lookup phonoglyph_collapse {
    ignore sub @letter p' r' o' n' u' n' c' i' a' t' i' o' n';
    ignore sub p' r' o' n' u' n' c' i' a' t' i' o' n' @letter;
    sub p' r' o' n' u' n' c' i' a' t' i' o' n' by w_pronunciation;
    ignore sub @letter t' y' p' o' g' r' a' p' h' y';
    ignore sub t' y' p' o' g' r' a' p' h' y' @letter;
    sub t' y' p' o' g' r' a' p' h' y' by w_typography;
    ignore sub @letter w' e' d' n' e' s' d' a' y';
    ignore sub w' e' d' n' e' s' d' a' y' @letter;
    sub w' e' d' n' e' s' d' a' y' by w_wednesday;
    ignore sub @letter l' a' u' g' h' t' e' r';
    ignore sub l' a' u' g' h' t' e' r' @letter;
    sub l' a' u' g' h' t' e' r' by w_laughter;
    ignore sub @letter f' e' b' r' u' a' r' y';
    ignore sub f' e' b' r' u' a' r' y' @letter;
    sub f' e' b' r' u' a' r' y' by w_february;
    ignore sub @letter q' u' e' s' t' i' o' n';
    ignore sub q' u' e' s' t' i' o' n' @letter;
    sub q' u' e' s' t' i' o' n' by w_question;
    ignore sub @letter b' e' c' a' u' s' e';
    ignore sub b' e' c' a' u' s' e' @letter;
    sub b' e' c' a' u' s' e' by w_because;
    ignore sub @letter t' h' r' o' u' g' h';
    ignore sub t' h' r' o' u' g' h' @letter;
    sub t' h' r' o' u' g' h' by w_through;
    ignore sub @letter t' h' o' u' g' h' t';
    ignore sub t' h' o' u' g' h' t' @letter;
    sub t' h' o' u' g' h' t' by w_thought;
    ignore sub @letter c' o' l' o' n' e' l';
    ignore sub c' o' l' o' n' e' l' @letter;
    sub c' o' l' o' n' e' l' by w_colonel;
    ignore sub @letter r' e' c' e' i' p' t';
    ignore sub r' e' c' e' i' p' t' @letter;
    sub r' e' c' e' i' p' t' by w_receipt;
    ignore sub @letter p' e' o' p' l' e';
    ignore sub p' e' o' p' l' e' @letter;
    sub p' e' o' p' l' e' by w_people;
    ignore sub @letter t' h' o' u' g' h';
    ignore sub t' h' o' u' g' h' @letter;
    sub t' h' o' u' g' h' by w_though;
    ignore sub @letter e' n' o' u' g' h';
    ignore sub e' n' o' u' g' h' @letter;
    sub e' n' o' u' g' h' by w_enough;
    ignore sub @letter i' s' l' a' n' d';
    ignore sub i' s' l' a' n' d' @letter;
    sub i' s' l' a' n' d' by w_island;
    ignore sub @letter n' a' t' i' o' n';
    ignore sub n' a' t' i' o' n' @letter;
    sub n' a' t' i' o' n' by w_nation;
    ignore sub @letter s' u' b' t' l' e';
    ignore sub s' u' b' t' l' e' @letter;
    sub s' u' b' t' l' e' by w_subtle;
    ignore sub @letter w' o' u' l' d';
    ignore sub w' o' u' l' d' @letter;
    sub w' o' u' l' d' by w_would;
    ignore sub @letter t' h' e' r' e';
    ignore sub t' h' e' r' e' @letter;
    sub t' h' e' r' e' by w_there;
    ignore sub @letter t' h' e' i' r';
    ignore sub t' h' e' i' r' @letter;
    sub t' h' e' i' r' by w_their;
    ignore sub @letter w' a' t' e' r';
    ignore sub w' a' t' e' r' @letter;
    sub w' a' t' e' r' by w_water;
    ignore sub @letter c' o' u' g' h';
    ignore sub c' o' u' g' h' @letter;
    sub c' o' u' g' h' by w_cough;
    ignore sub @letter y' a' c' h' t';
    ignore sub y' a' c' h' t' @letter;
    sub y' a' c' h' t' by w_yacht;
    ignore sub @letter c' h' o' i' r';
