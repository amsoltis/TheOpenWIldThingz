    ignore sub @letter g' n' o' m' e';
    ignore sub g' n' o' m' e' @letter;
    sub g' n' o' m' e' by w_gnome;
    ignore sub @letter s' w' o' r' d';
    ignore sub s' w' o' r' d' @letter;
    sub s' w' o' r' d' by w_sword;
    ignore sub @letter t' h' a' t';
    ignore sub t' h' a' t' @letter;
    sub t' h' a' t' by w_that;
    ignore sub @letter h' a' v' e';
    ignore sub h' a' v' e' @letter;
    sub h' a' v' e' by w_have;
    ignore sub @letter w' i' t' h';
    ignore sub w' i' t' h' @letter;
    sub w' i' t' h' by w_with;
    ignore sub @letter t' h' i' s';
    ignore sub t' h' i' s' @letter;
    sub t' h' i' s' by w_this;
    ignore sub @letter f' r' o' m';
    ignore sub f' r' o' m' @letter;
    sub f' r' o' m' by w_from;
    ignore sub @letter t' h' e' y';
    ignore sub t' h' e' y' @letter;
    sub t' h' e' y' by w_they;
    ignore sub @letter w' i' l' l';
    ignore sub w' i' l' l' @letter;
    sub w' i' l' l' by w_will;
    ignore sub @letter w' h' a' t';
    ignore sub w' h' a' t' @letter;
    sub w' h' a' t' by w_what;
    ignore sub @letter t' h' e';
    ignore sub t' h' e' @letter;
    sub t' h' e' by w_the;
    ignore sub @letter a' n' d';
    ignore sub a' n' d' @letter;
    sub a' n' d' by w_and;
    ignore sub @letter f' o' r';
    ignore sub f' o' r' @letter;
    sub f' o' r' by w_for;
    ignore sub @letter n' o' t';
    ignore sub n' o' t' @letter;
