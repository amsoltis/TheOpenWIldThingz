{
  "expo": {
    "name": "Streetlevel",
    "slug": "streetlevel",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "streetlevel",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2EEE4",
    "primaryColor": "#D82233",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2EEE4"
    },
    "ios": {
      "bundleIdentifier": "app.streetlevel.client",
      "buildNumber": "1",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "UIUserInterfaceStyle": "Light",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Photograph a station sign and Streetlevel will work out where you are. The photo is read on this phone and never leaves it.",
        "NSMotionUsageDescription": "Streetlevel counts the stops you pass using the phone's motion sensor, so it can keep track of where you are underground where there is no signal.",
        "NSLocationWhenInUseUsageDescription": "Used above ground to find the station entrance nearest to you. Streetlevel does not track you underground — there is no signal down there anyway."
      }
    },
    "android": {
      "package": "app.streetlevel.client",
      "versionCode": 1,
      "userInterfaceStyle": "light",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2EEE4"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F2EEE4"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Photograph a station sign and Streetlevel will work out where you are. The photo is read on this phone and never leaves it.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.streetlevel.app",
      "freeCreditAllowance": 3,
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
