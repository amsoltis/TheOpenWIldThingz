# Copy to .env for local runs. Every value here has a working default except
# DATABASE_URL — without it, credit balances live in memory and vanish on restart.

PORT=8080
HOST=0.0.0.0

# Free round-trip packets granted to a new device.
FREE_CREDITS=3

# Postgres. Omit to use the in-memory account store (development only).
DATABASE_URL=postgres://streetlevel:streetlevel@localhost:5432/streetlevel

# Planned service changes. Set at most one.
#   ALERTS_FILE — a JSON array of ServiceAlert written by the sync worker
#   ALERTS_URL  — an endpoint serving the same shape
# With neither set, the router plans against the published timetable alone.
#ALERTS_FILE=./alerts.json
#ALERTS_URL=https://example.internal/streetlevel/alerts.json
ALERTS_REFRESH_MS=43200000

# Nvidia NIM prose pass. Leaving NIM_BASE_URL empty is a supported production
# posture: the deterministic compiler produces complete, correct packets on its
# own, and the model is only ever allowed to rewrite prose that is already right.
#NIM_BASE_URL=http://localhost:8000/v1
#NIM_MODEL=meta/llama-3.1-8b-instruct
#NIM_API_KEY=
#NIM_TIMEOUT_MS=4000
#NIM_DISABLED=0
