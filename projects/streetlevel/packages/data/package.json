{
  "name": "@streetlevel/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Imports the MTA's GTFS static feed into a compact station graph, and carries the hand-surveyed micro-navigation dataset that no public feed contains.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./network": "./generated/network.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fetch:gtfs": "tsx src/scripts/fetch-gtfs.ts",
    "build:dataset": "tsx src/scripts/build-network.ts",
    "build:sqlite": "tsx src/scripts/emit-sqlite-seed.ts",
    "verify:sqlite": "node --experimental-sqlite --import tsx src/scripts/verify-sqlite-seed.ts"
  },
  "dependencies": {
    "@streetlevel/shared": "*",
    "fflate": "^0.8.2"
  }
}
