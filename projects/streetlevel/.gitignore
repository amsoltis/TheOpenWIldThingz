node_modules/
dist/
*.tsbuildinfo

# The unpacked GTFS feed is ~42 MB of build input, re-fetchable with
# `npm run fetch:gtfs`. The compiled station graph it produces
# (packages/data/generated/) is committed instead — that is the artefact the
# router and the tests actually read, and it records the feed version it came
# from so a stale build is obvious.
packages/data/vendor/

.expo/
.env
.env.*
!.env.example

# Screenshot harness build output. The gallery PNG is committed as the visual
# record of what the client renders; the bundle and fixtures are regenerated by
# `npm run screenshot`.
tools/screenshot/generated/*
!tools/screenshot/generated/screens.png

# Design study build output; the comparison sheet is the artefact worth keeping.
tools/design-study/generated/*
!tools/design-study/generated/study.png
